<UserControl
    x:Class="ManifestApp.Controls.PairingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock Text="OPENSTEAM API"
                       FontSize="11" FontWeight="SemiBold"
                       CharacterSpacing="220"
                       Foreground="{StaticResource OpenSteamAccentGradientBrush}" />
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Authorize manifest downloads" />
        </StackPanel>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Get your API key from Discord — one key per PC. Generate a pairing code below, run `/key pair` in the OpenSteam Discord server, then tap Check for key."
            TextWrapping="WrapWholeWords" />

        <Border CornerRadius="12" Padding="20,16"
                BorderThickness="1"
                BorderBrush="{StaticResource OpenSteamSubtleAccentStrokeBrush}"
                Background="{StaticResource OpenSteamSubtleAccentBackgroundBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="PAIRING CODE"
                           FontSize="11" FontWeight="SemiBold"
                           CharacterSpacing="200"
                           Foreground="{StaticResource OpenSteamAccentGradientBrush}" />

                <Button x:Name="CopyCodeButton"
                        Click="CopyPairingCode_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ToolTipService.ToolTip="Copy pairing code">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PairingCodeText"
                                   FontFamily="Consolas"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FFEDEDF5"
                                   Text="--------" />
                        <TextBlock x:Name="PairingCopyHintText"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Click to copy code" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="PairingCopyFeedback"
                           FontSize="11"
                           Foreground="{StaticResource OpenSteamAccentGradientBrush}"
                           Visibility="Collapsed" />

                <TextBlock x:Name="PairingHintText"
                           Foreground="{StaticResource OpenSteamSecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="WrapWholeWords"
                           Text="Run in Discord: /key pair code:XXXXXXXX" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="GeneratePairingCodeButton" Click="GeneratePairingCode_Click" Content="Generate code" />
                    <Button x:Name="RefreshPairingButton" Click="RefreshPairing_Click" Content="Check for key" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="PairingStatusText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            FontSize="12"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />

        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="WrapWholeWords"
            Text="Or paste a key you already received from Discord:" />

        <PasswordBox
            x:Name="ApiKeyBox"
            Header="Your OpenSteam API key"
            PlaceholderText="mg_..." />

        <Button Click="SaveManualKey_Click"
                Content="Save API key"
                Style="{StaticResource AccentButtonStyle}" />

        <TextBlock
            x:Name="ApiKeyStatus"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
